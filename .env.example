# Set true for clearly labeled illustrative demo prices. Set false for live integrations.
USE_MOCK_DATA=true

# Finnhub API token (server-side only) for underlying US equity quotes.
FINNHUB_API_KEY=

# Optional GeckoTerminal network slug. Robinhood Chain was not available in its public network catalog at build time, so leave blank unless a valid slug is confirmed.
GECKO_TERMINAL_NETWORK_ID=

# Canonical public Robinhood Chain RPC. Current provider path uses RH asset API + DexScreener.
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com/

# Public site origin used in metadata, sitemap and OG cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
